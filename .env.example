# Postgres (Neon ou Supabase — conecte na Vercel via integração 1-clique)
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"
DIRECT_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# Chave secreta para assinar o cookie de sessão do admin (string aleatória longa)
SESSION_SECRET="gere-uma-string-aleatoria-longa-aqui"

# Usadas SÓ na hora de rodar `npm run db:seed-admins` (não ficam salvas em lugar
# nenhum além do hash no banco). Defina senhas fortes antes de rodar o seed.
ADMIN_YTALO_PASSWORD=""
ADMIN_TARCISIO_PASSWORD=""
