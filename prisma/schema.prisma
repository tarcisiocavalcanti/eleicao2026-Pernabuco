// Schema do Agregador de Pesquisas Eleitorais (PE + Brasil)
// Banco recomendado: Postgres via Neon ou Supabase (integração 1-clique com a Vercel)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Uma pesquisa publicada por um instituto (ex: Datafolha, Quaest, AtlasIntel,
// ou institutos locais de PE), em um recorte geográfico e cargo específicos.
model Pesquisa {
  id               String    @id @default(cuid())
  instituto        String
  contratante      String?
  cargo            String // presidente | governador | prefeito | senador | deputado...
  abrangencia      String // "BR" | "PE" | nome do município
  municipio        String? // preenchido quando abrangencia = município
  dataCampoInicio  DateTime
  dataCampoFim     DateTime
  dataDivulgacao   DateTime
  amostra          Int?
  margemErro       Float? // em pontos percentuais, ex: 2.0
  registroTse      String?
  fonteUrl         String?
  observacoes      String?
  cenarios         Cenario[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([abrangencia, cargo])
  @@index([dataDivulgacao])
}

// Uma pesquisa pode ter múltiplos cenários (estimulada, espontânea, rejeição,
// com/sem determinado candidato)
model Cenario {
  id          String      @id @default(cuid())
  pesquisa    Pesquisa    @relation(fields: [pesquisaId], references: [id], onDelete: Cascade)
  pesquisaId  String
  tipo        String // estimulada | espontanea | rejeicao
  descricao   String? // ex: "cenário sem o candidato X"
  resultados  Resultado[]

  @@index([pesquisaId])
}

model Admin {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Candidato {
  id          String      @id @default(cuid())
  nome        String
  partido     String      @default("")
  numero      Int?
  resultados  Resultado[]

  @@unique([nome, partido])
}

model Resultado {
  id           String     @id @default(cuid())
  cenario      Cenario    @relation(fields: [cenarioId], references: [id], onDelete: Cascade)
  cenarioId    String
  candidato    Candidato  @relation(fields: [candidatoId], references: [id])
  candidatoId  String
  percentual   Float

  @@unique([cenarioId, candidatoId])
}
